# EasyBrowser outward service bind address
EASYBROWSER_LISTEN=127.0.0.1:18080

# Optional helper-only base URL override for deploy scripts
EASYBROWSER_BASE_URL=http://127.0.0.1:18080

# Optional helper-only smoke defaults
EASYBROWSER_SMOKE_PROVIDER=
EASYBROWSER_SMOKE_URL=http://127.0.0.1:18888/recaptcha_v3.html

# Current local build has no API auth enforcement. If you later place EasyBrowser
# behind a reverse proxy, you can let your wrapper scripts inject auth there.
